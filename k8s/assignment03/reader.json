{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "assignment03-reader",
    "namespace": "rahbar"
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "reader",
        "image": "rahbar-indexer:a03-20261126",
        "command": [
          "python",
          "-c",
          "import time; time.sleep(86400)"
        ],
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "128Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "results",
            "mountPath": "/results",
            "readOnly": true
          },
          {
            "name": "data",
            "mountPath": "/data",
            "readOnly": true
          },
          {
            "name": "traces",
            "mountPath": "/traces",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "results",
        "persistentVolumeClaim": {
          "claimName": "rahbar-evaluation"
        }
      },
      {
        "name": "data",
        "persistentVolumeClaim": {
          "claimName": "rahbar-data-lake"
        }
      },
      {
        "name": "traces",
        "persistentVolumeClaim": {
          "claimName": "rahbar-traces"
        }
      }
    ]
  }
}
