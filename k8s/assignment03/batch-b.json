{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "assignment03-batch-b",
    "namespace": "rahbar"
  },
  "spec": {
    "backoffLimit": 2,
    "ttlSecondsAfterFinished": 86400,
    "template": {
      "metadata": {
        "labels": {
          "app": "indexer"
        }
      },
      "spec": {
        "serviceAccountName": "rahbar-indexer",
        "automountServiceAccountToken": false,
        "restartPolicy": "OnFailure",
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10002,
          "runAsGroup": 10002,
          "fsGroup": 10002
        },
        "initContainers": [
          {
            "name": "seed-data-lake",
            "image": "rahbar-indexer:a03-20261126",
            "command": [
              "python",
              "/app/seed_corpus.py"
            ],
            "envFrom": [
              {
                "configMapRef": {
                  "name": "rahbar-config"
                }
              }
            ],
            "volumeMounts": [
              {
                "name": "data-lake",
                "mountPath": "/data"
              }
            ]
          },
          {
            "name": "stage-batch-b",
            "image": "rahbar-indexer:a03-20261126",
            "command": [
              "python",
              "-c",
              "import json, shutil\nfrom pathlib import Path\nfrom pipeline.run import _front_matter\nroot=Path('/data/corpus'); index=root/'raw/_index.json'\nentries=json.loads(index.read_text()); known={e['file'] for e in entries}\nfor source in sorted(Path('/corpus/batch-b').iterdir()):\n    if source.name=='MANIFEST.md' or source.name in known: continue\n    shutil.copy2(source,index.parent/source.name)\n    meta=_front_matter(source) if source.suffix=='.md' else {}\n    entries.append({'file':source.name,'doc_version':meta.get('doc_version','unknown'),'superseded':False})\nindex.write_text(json.dumps(entries))"
            ],
            "volumeMounts": [
              {
                "name": "data-lake",
                "mountPath": "/data"
              }
            ]
          }
        ],
        "containers": [
          {
            "name": "indexer",
            "image": "rahbar-indexer:a03-20261126",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "python",
              "-m",
              "pipeline.run"
            ],
            "envFrom": [
              {
                "configMapRef": {
                  "name": "rahbar-config"
                }
              }
            ],
            "volumeMounts": [
              {
                "name": "data-lake",
                "mountPath": "/data"
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "256Mi"
              },
              "limits": {
                "cpu": 1,
                "memory": "2Gi"
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "data-lake",
            "persistentVolumeClaim": {
              "claimName": "rahbar-data-lake"
            }
          }
        ]
      }
    }
  }
}
